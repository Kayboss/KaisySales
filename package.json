{
  "name": "submission-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "secrets": "node scripts/secret-scan.mjs",
    "secrets:history": "node scripts/secret-scan.mjs --history",
    "scan:dist": "node scripts/scan-dist.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:authz": "node scripts/test-authz.mjs",
    "verify": "npm run lint && npm test && npm run audit && npm run secrets && npm run build && npm run scan:dist",
    "verify:full": "npm run verify && npm run test:authz",
    "release": "npm run verify && vercel --prod --yes"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "styled-components": "^6.5.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.2"
  }
}
