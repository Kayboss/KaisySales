# =========================================================================
# KaisySales Supabase Configuration
# =========================================================================
# Copy this file to '.env' and fill in your actual credentials from
# your Supabase project → Settings → API
# =========================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions
# Deploy admin verification function via: supabase functions deploy verify-admin
VITE_VERIFY_ADMIN_FUNCTION_URL=https://your-project.supabase.co/functions/v1/verify-admin

# =========================================================================
# Release gate (local only — this file is a template, never a credential)
# =========================================================================
# Personal access token from the Supabase dashboard -> Account -> Access Tokens.
# The same token applies migrations through the Management API, and
# `npm run release` reads it to check that production already has every
# migration in supabase/migrations before shipping the frontend. Put it in the
# gitignored '.env', never in Vercel. Without it the release gate blocks the
# deploy rather than guessing.
SUPABASE_ACCESS_TOKEN=your-personal-access-token-here
