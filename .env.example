# =========================================================================
# KaisySales Supabase Configuration
# =========================================================================
# Copy this file to '.env' and fill in your actual credentials from
# your Supabase project → Settings → API
# =========================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions
# Deploy admin verification function via: supabase functions deploy verify-admin
VITE_VERIFY_ADMIN_FUNCTION_URL=https://your-project.supabase.co/functions/v1/verify-admin
