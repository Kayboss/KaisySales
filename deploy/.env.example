# KaisySales FTP Deploy Configuration
# Fill in your cPanel FTP credentials

# Your cPanel hostname or IP
FTP_HOST=ftp.yourdomain.com

# cPanel FTP username
FTP_USER=your_username

# cPanel FTP password
FTP_PASS=your_password

# Remote path to public_html (e.g. /public_html or /public_html/kaisysales)
REMOTE_PATH=/public_html

# Set to false if your cPanel doesn't support FTPS (most do)
FTP_SECURE=true
